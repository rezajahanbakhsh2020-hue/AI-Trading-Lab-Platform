# AI-Trading-Lab-Platform Environment Configuration Example

APP_ENV=development
PORT=8000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000

# Session & Authentication Secrets
SESSION_SECRET=dev_session_secret_key_change_in_production_2026
INITIAL_ADMIN_PASSWORD=DevAdminSecureKey2026!

# Owner Identity & Security Recovery Contact
OWNER_USER_ID=admin_owner
OWNER_EMAIL=Reza.jahanbakhsh2020@gmail.com
